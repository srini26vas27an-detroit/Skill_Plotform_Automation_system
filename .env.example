# Copy to .env and fill in. Never commit .env.
TARGET_URL=https://your-practice-question-or-dashboard-url
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
EDITOR_SELECTOR=#ctutortxtCode
# Narrow this once you know the question container (use `diagnose`), e.g. #questionPanel
QUESTION_SELECTOR=body
REQUEST_TIMEOUT=180
MAX_QUESTION_CHARS=6000

# --- Continuous loop ---
# CSS selector of the site's "Next" button. Find it with `diagnose` (see Buttons section).
NEXT_SELECTOR=
# Regex of text that appears after a successful submit (e.g. "Congratulations|Passed"). Optional;
# if empty, type `next` in the terminal after you submit.
SUCCESS_PATTERN=
# Keep the model loaded in memory between questions
OLLAMA_KEEP_ALIVE=60m
# Force a language instead of auto-detecting (Python, C, C++, Java, SQL). Optional.
LANGUAGE=
